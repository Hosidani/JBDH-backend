@model IEnumerable<JBDH.Models.DataFlow>

@{
    ViewData["Title"] = "Home";
    var isLoggedIn = User.Identity.IsAuthenticated; // Check if the user is authenticated
    var username = User.Identity.IsAuthenticated ? User.Identity.Name : null; // Get the username from the identity
}



<h2>User posts</h2>
<a href="@Url.Action("CreateFlow")">Create new post</a>
@foreach(var flow in Model)
{
    <div>
        <b>@flow.ContentType</b>: @flow.Content <br />
        <small>@flow.CreatedAt</small>
    </div>
}