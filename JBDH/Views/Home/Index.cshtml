@model JBDH.Models.ViewModels.ListDataFlowViewModel

@{
    ViewData["Title"] = "Home";
    var isLoggedIn = User.Identity.IsAuthenticated;
    var username = isLoggedIn ? User.Identity.Name : null;
}

<h2>Posts</h2>
<div style="text-align: right;">
    <a href="@Url.Action("CreateFlow")">Create new post</a>
</div>

@foreach (var post in Model.DataFlows)
{
    <div class="dataflow-post mb-3">
        <p>@post.Content</p>
        <button type="button" class="btn btn-danger btn-sm" onclick="toggleReportForm(@post.Id)">Report</button>
        <form asp-action="ReportDataFlow" asp-controller="Home" method="post" style="display:none;" id="reportForm_@post.Id" class="mt-2">
            <input type="hidden" name="reportedUserId" value="@post.UserId" />
            <input type="hidden" name="dataFlowId" value="@post.Id" />
            <input type="hidden" name="dataFlowText" value="@post.Content" />
            <textarea name="reason" maxlength="100" placeholder="Ange anledning (max 100 tecken)" 
                      class="form-control mb-2" style="width:200px;display:inline-block;" 
                      oninput="updateCharCount(this, 'charCount_@post.Id')"></textarea>
            <div style="font-size: 0.9em; color: #666;">
                <span id="charCount_@post.Id">100</span> tecken kvar
            </div>
            <button type="submit" class="btn btn-danger btn-sm mt-1">Skicka rapport</button>
        </form>

        <!-- Comment toggle button -->
        <button type="button" class="btn btn-primary btn-sm" onclick="toggleComments(@post.Id)">Comments</button>

        <!-- Comments, replies, and comment form (hidden by default) -->
        <div id="commentsSection_@post.Id" style="display:none; margin-top:10px;">
            <!-- Add Comment Form -->
            <form asp-action="CommentOnDataFlow" method="post">
                <input type="hidden" name="dataFlowId" value="@post.Id" />
                <textarea name="comment"></textarea>
                <button type="submit">Add Comment</button>
            </form>
            <!-- Render ONLY the comments/replies, NOT the post itself -->
            @if (post.RelatedDataFlows != null && post.RelatedDataFlows.Any())
            {
                @foreach (var comment in post.RelatedDataFlows)
                {
                    @Html.Partial("_DataFlowThread", comment)
                }
            }
        </div>
    </div>
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function toggleReportForm(id) {
            var form = document.getElementById('reportForm_' + id);
            if (form.style.display === 'none') {
                form.style.display = 'block';
            } else {
                form.style.display = 'none';
            }
        }
        function updateCharCount(textarea, counterId) {
            var max = 100;
            var left = max - textarea.value.length;
            document.getElementById(counterId).innerText = left;
        }
        function toggleComments(id) {
            var section = document.getElementById('commentsSection_' + id);
            if (section.style.display === 'none') {
                section.style.display = 'block';
            } else {
                section.style.display = 'none';
            }
        }
        function toggleReplyForm(id) {
            var form = document.getElementById('replyForm_' + id);
            if (form.style.display === 'none') {
                form.style.display = 'block';
            } else {
                form.style.display = 'none';
            }
        }

        // AJAX for reply forms
        $(document).on('submit', '.reply-form', function (e) {
            e.preventDefault();
            var $form = $(this);
            $.ajax({
                url: '@Url.Action("CommentOnDataFlow", "Home")',
                type: 'POST',
                data: $form.serialize(),
                success: function (result) {
                    location.reload(); // Reload to show the new reply
                },
                error: function () {
                    alert('Failed to add reply.');
                }
            });
        });
    </script>
}