@model List<(int Priority, Dictionary<string, object> Job)>

@{
    ViewData["Title"] = "Search Results";
}

<div class="text-center">
    <h1 class="display-4">Search Results</h1>

    @if (Model == null || Model.Count == 0)
    {
        <p>No jobs found matching your criteria.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Priority</th>
                    <th>Title</th>
                    <th>Company</th>
                    <th>Location</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Priority</td>
                        <td>@(item.Job.ContainsKey("title") ? item.Job["title"] : "N/A")</td>
                        <td>@(item.Job.ContainsKey("company") ? item.Job["company"] : "N/A")</td>
                        <td>@(item.Job.ContainsKey("location") ? item.Job["location"] : "N/A")</td>
                        <td>@(item.Job.ContainsKey("description") ? item.Job["description"] : "N/A")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
