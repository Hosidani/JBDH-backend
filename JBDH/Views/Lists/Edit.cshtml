@model JBDH.Models.Kanban.KanbanList
@{
    ViewData["Title"] = "Edit List";
}
<h2>Edit List</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="BoardId" />
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Order"></label>
        <input asp-for="Order" class="form-control" type="number" />
        <span asp-validation-for="Order" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Save</button>
    <a class="btn btn-secondary mt-2" href="@Url.Action("Details", "Boards", new { id = Model.BoardId })">Cancel</a>
</form> 