@model JBDH.Models.Kanban.KanbanList
@{
    ViewData["Title"] = "Delete List";
}
<h2>Delete List</h2>
<h4>Are you sure you want to delete this list?</h4>
<div>
    <strong>@Model.Name</strong>
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="BoardId" />
    <button type="submit" class="btn btn-danger mt-2">Delete</button>
    <a class="btn btn-secondary mt-2" href="@Url.Action("Details", "Boards", new { id = Model.BoardId })">Cancel</a>
</form> 