@model JBDH.Models.Kanban.Board
@{
    ViewData["Title"] = "Board Details";
}
<h2>Board: @Model.Name</h2>
<p>
    <a class="btn btn-warning" href="@Url.Action("Edit", new { id = Model.Id })">Edit</a>
    <a class="btn btn-secondary" href="@Url.Action("Index")">Back to Boards</a>
</p>
<hr />
<h4>Lists</h4>
<p>
    <a class="btn btn-primary" href="@Url.Action("Create", "Lists", new { boardId = Model.Id })">Add List</a>
</p>
@if (Model.Lists != null && Model.Lists.Any())
{
    <div class="row">
        @foreach (var list in Model.Lists.OrderBy(l => l.Order))
        {
            <div class="col-md-4">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>@list.Name</span>
                        <span>
                            <a class="btn btn-sm btn-warning" href="@Url.Action("Edit", "Lists", new { id = list.Id })">Edit</a>
                            <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", "Lists", new { id = list.Id })">Delete</a>
                        </span>
                    </div>
                    <div class="card-body">
                        <h6>Cards</h6>
                        <a class="btn btn-sm btn-primary mb-2" href="@Url.Action("Create", "Cards", new { listId = list.Id })">Add Card</a>
                        @if (list.Cards != null && list.Cards.Any())
                        {
                            <ul class="list-group">
                                @foreach (var card in list.Cards.OrderBy(c => c.Order))
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>
                                            <strong>@card.Title</strong><br />
                                            <small>@card.Description</small>
                                            @if (card.DueDate != null)
                                            {
                                                <br /><span class="badge bg-info">Due: @card.DueDate.Value.ToShortDateString()</span>
                                            }
                                        </span>
                                        <span>
                                            <a class="btn btn-sm btn-warning" href="@Url.Action("Edit", "Cards", new { id = card.Id })">Edit</a>
                                            <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", "Cards", new { id = card.Id })">Delete</a>
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-muted">No cards in this list.</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-muted">No lists in this board yet.</div>
} 