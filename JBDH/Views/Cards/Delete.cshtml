@model JBDH.Models.Kanban.Card
@{
    ViewData["Title"] = "Delete Card";
}
<h2>Delete Card</h2>
<h4>Are you sure you want to delete this card?</h4>
<div>
    <strong>@Model.Title</strong>
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ListId" />
    <button type="submit" class="btn btn-danger mt-2">Delete</button>
    <a class="btn btn-secondary mt-2" href="@Url.Action("Details", "Boards", new { id = ViewBag.BoardId })">Cancel</a>
</form> 