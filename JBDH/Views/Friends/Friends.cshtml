@{
    ViewData["Title"] = "Friend Requests";
}

<h1>Friend Requests</h1>

<h3>Sent Requests</h3>
<ul>
@foreach (var request in Model.SentFriendRequests)
{
    <li>
        <span>@request.Addressee.Username</span>
        <span>Pending</span>
    </li>
}
</ul>

<h3>Received Requests</h3>
<ul>
@foreach (var request in Model.ReceivedFriendRequests)
{
    <li>
        <span>@request.Requester.Username</span>
        <form method="post" asp-action="AcceptRequest" asp-route-requestId="@request.Id">
        <button type="submit">Accept</button>
        <form method="post" asp-action="RejectRequest" asp-route-requestId="@request.Id">
        <button type="submit">Reject</button>
        </form>
        </form>
    </li>
}
</ul>

<h1>My Friends</h1>

<ul>
@foreach (var friend in Model.Friends)
{
    <li>@friend.Username</li>
}
</ul>