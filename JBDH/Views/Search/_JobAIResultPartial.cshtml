@model CVJobComparisonAIResponseViewModel

@if (Model != null)
{
    <div class="ai-response">
        <strong>AI Analysis:</strong>
        <dl>
            <dt>Fit Summary</dt>
            <dd>@Model.FitSummary</dd>

            <dt>Missing Requirements</dt>
            <dd>
                <ul>
                    @foreach (var req in Model.MissingRequirements ?? new List<string>())
                    {
                        <li>@req</li>
                    }
                </ul>
            </dd>

            <dt>Matching Skills</dt>
            <dd>
                <ul>
                    @foreach (var skill in Model.MatchingSkills ?? new List<string>())
                    {
                        <li>@skill</li>
                    }
                </ul>
            </dd>

            <dt>Relevant Experiences</dt>
            <dd>
                <ul>
                    @foreach (var exp in Model.RelevantExperiences ?? new List<string>())
                    {
                        <li>@exp</li>
                    }
                </ul>
            </dd>

            <dt>Education and Certifications</dt>
            <dd>
                <ul>
                    @foreach (var edu in Model.EducationAndCertifications ?? new List<string>())
                    {
                        <li>@edu</li>
                    }
                </ul>
            </dd>
        </dl>
    </div>
}