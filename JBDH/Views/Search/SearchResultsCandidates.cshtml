@model List<SearchCandidateViewModel>
@using Markdig

@{
    ViewData["Title"] = "Candidate Results";
    var keyword = ViewData["keyword"] as string;
}

<div class="text-center">
    <h1 class="display-4">Candidate Results</h1>

    @if (Model == null || Model.Count == 0)
    {
        <p>No candidates found matching your criteria.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Priority</th>
                    <th>Email</th>
                    <th>Location</th>
                    <th>AI Response</th>
                    <th>AI Response Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var candidate in Model)
                {
                    <tr>
                        <td>@candidate.Priority</td>
                        <td>@candidate.Email</td>
                        <td>@candidate.Location</td>
                        <td>
                            @if (candidate.UserAIResponse != null && !string.IsNullOrEmpty(candidate.UserAIResponse.ResponseText) )
                            {
                                var aiText = candidate.UserAIResponse.ResponseText;
                                if (!string.IsNullOrEmpty(keyword))
                                {
                                    var idx = aiText.ToLower().IndexOf(keyword.ToLower());
                                    if (idx >= 0)
                                    {
                                        var previewLength = 40;
                                        var start = Math.Max(0, idx - 10);
                                        var length = Math.Min(previewLength, aiText.Length - start);
                                        var preview = aiText.Substring(start, length);
                                        <span>@preview ...</span>
                                    }
                                    else
                                    {
                                        @if (!string.IsNullOrEmpty(aiText))
                                        {
                                            <span>@aiText.Substring(0, Math.Min(40, aiText.Length)) ...</span>
                                        }
                                    }
                                }
                                else
                                {
                                    @if (!string.IsNullOrEmpty(aiText))
                                    {
                                        <span>@aiText.Substring(0, Math.Min(40, aiText.Length)) ...</span>
                                    }
                                }
                                <button type="button" class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#aiModal_@candidate.UserId">
                                    View more
                                </button>
                            }
                        </td>
                        <td>
                            @(candidate.UserAIResponse != null ? candidate.UserAIResponse.CreatedAt.ToString("yyyy-MM-dd HH:mm") : "")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@foreach (var candidate in Model)
{
    if (candidate.UserAIResponse != null && !string.IsNullOrEmpty(candidate.UserAIResponse.ResponseText))
    {
        <div class="modal fade" id="aiModal_@candidate.UserId" tabindex="-1" aria-labelledby="aiModalLabel_@candidate.UserId" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="aiModalLabel_@candidate.UserId">Full AI Response</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @Html.Raw(Markdown.ToHtml(candidate.UserAIResponse?.ResponseText ?? ""))
                    </div>
                </div>
            </div>
        </div>
    }
}