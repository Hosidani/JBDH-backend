@model List<SearchCandidateViewModel>
@using Markdig

@{
    ViewData["Title"] = "Candidate Results";
    var keyword = ViewData["keyword"] as string;
}

<div class="text-center">
    <h1 class="display-4">Candidate Results</h1>

    @if (Model == null || Model.Count == 0)
    {
        <p>No candidates found matching your criteria.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Priority</th>
                    <th>Username</th>
                    <th>Location</th>
                    <th>AI Response</th>
                    <th>AI Response Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var candidate in Model)
                {
                    <tr>
                        <td>@candidate.Priority</td>
                        <td>@candidate.Username</td>
                        <td>@candidate.Location</td>
                        <td>
                            @if (!string.IsNullOrEmpty(candidate.AIResponse) && !string.IsNullOrEmpty(keyword))
                            {
                                // Visa bara första matchningen av keyword i texten, eller en kort preview
                                var idx = candidate.AIResponse.ToLower().IndexOf(keyword.ToLower());
                                if (idx >= 0)
                                {
                                    var previewLength = 40;
                                    var start = Math.Max(0, idx - 10);
                                    var length = Math.Min(previewLength, candidate.AIResponse.Length - start);
                                    var preview = candidate.AIResponse.Substring(start, length);
                                    <span>@preview ...</span>
                                }
                                else
                                {
                                    <span>@candidate.AIResponse.Substring(0, Math.Min(40, candidate.AIResponse.Length)) ...</span>
                                }
                                <button type="button" class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#aiModal_@candidate.UserId">
                                    View more
                                </button>
                            }
                        </td>
                        <td>
                            @candidate.AIResponseCreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@foreach (var candidate in Model)
{
    <div class="modal fade" id="aiModal_@candidate.UserId" tabindex="-1" aria-labelledby="aiModalLabel_@candidate.UserId" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="aiModalLabel_@candidate.UserId">Full AI Response</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @Html.Raw(Markdown.ToHtml(candidate.AIResponse ?? ""))
                </div>
            </div>
        </div>
    </div>
}