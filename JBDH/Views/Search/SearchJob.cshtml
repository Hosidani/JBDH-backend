@{
    ViewData["Title"] = "Search";
    bool isLoggedIn = User.Identity.IsAuthenticated;
    string username = isLoggedIn ? User.Identity.Name : "Guest";
    // Optionally, get the user's CV path from ViewData or Model if you pass it from the controller
    string userCVPath = ViewData["UserCVPath"] as string;
}
<div class="text-center">
    <h1 class="display-4">Job Search</h1>
    <p>Search for jobs by description and location.</p>
    <form asp-controller="Search" asp-action="SearchForJobs" method="get">
        <label for="desc1" class="visually-hidden">Job description</label>
        <input id="desc1" type="text" name="description" placeholder="Enter job description">
        <label for="loc1" class="visually-hidden">Location</label>
        <input id="loc1" type="text" name="location" placeholder="Enter location">
        <button type="submit">Search</button>
    </form>

    <!-- New form for Analyze CV against Job -->
    <form asp-controller="Search" asp-action="SearchForJobsAndAnalyzeCVAgainstJob" method="get" class="mt-3">
        <label for="desc2" class="visually-hidden">Job description</label>
        <input id="desc2" type="text" name="description" placeholder="Enter job description">
        <label for="loc2" class="visually-hidden">Location</label>
        <input id="loc2" type="text" name="location" placeholder="Enter location">
        <button type="submit" class="btn btn-warning">Analyze CV Against Job</button>
    </form>

    @if (isLoggedIn)
    {
        <div class="mt-4">
            <h2>Welcome, @username!</h2>
            <p>Feel free to search for jobs.</p>
        </div>
    }
    else
    {
        <p>Please log in to access more features.</p>
    }
</div>