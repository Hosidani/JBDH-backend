@model List<JBDH.Models.User.User>

@{
    ViewData["Title"] = "User Search";
}

<h2>User Search</h2>

<form method="get" asp-action="SearchUsers">
    <input type="text" name="query" placeholder="Search users..." value="@Context.Request.Query["query"]" class="form-control mb-2" />
    <button type="submit" class="btn btn-primary">Search</button>
</form>

@if (Model != null && Model.Any())
{
    <ul class="list-group mt-3">
        @foreach (var user in Model)
        {
            <li class="list-group-item">
                <a asp-controller="Profile" asp-action="Profile" asp-route-userId="@user.Id">
                    @user.Username (@user.Email)
                </a>
            </li>
        }
    </ul>
}
else if (!string.IsNullOrWhiteSpace(Context.Request.Query["query"]))
{
    <p>No users found.</p>
}