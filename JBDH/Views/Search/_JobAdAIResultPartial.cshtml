@model JobAdAIResponseViewModel

@if (Model == null)
{
    <div>No analysis data available.</div>
}
else
{
    <div class="ai-response">
        <strong>Job Ad AI Analysis:</strong>
        <dl>
            <dt>Job Titles</dt>
            <dd>
                <ul>
                @foreach (var title in Model.JobTitle ?? new List<string>())
                {
                    <li>@title</li>
                }
                </ul>
            </dd>
            <dt>Hard Requirements</dt>
            <dd>
                <ul>
                @foreach (var req in Model.HardRequirements ?? new List<string>())
                {
                    <li>@req</li>
                }
                </ul>
            </dd>
            <dt>Good To Haves</dt>
            <dd>
                <ul>
                @foreach (var req in Model.GoodToHaves ?? new List<string>())
                {
                    <li>@req</li>
                }
                </ul>
            </dd>
            <dt>Experiences</dt>
            <dd>
                <ul>
                @foreach (var exp in Model.Experiences ?? new List<string>())
                {
                    <li>@exp</li>
                }
                </ul>
            </dd>
            <dt>Education and Certifications</dt>
            <dd>
                <ul>
                @foreach (var edu in Model.EducationAndCertifications ?? new List<string>())
                {
                    <li>@edu</li>
                }
                </ul>
            </dd>
            <dt>Job Summary</dt>
            <dd>@Model.JobSummary</dd>
        </dl>
    </div>
}