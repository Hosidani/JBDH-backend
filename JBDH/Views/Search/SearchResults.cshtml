@model List<(int Priority, Dictionary<string, object> Job)>

@{
    ViewData["Title"] = "Search Results";
}

<div class="text-center">
    <h1 class="display-4">Search Results</h1>

    @if (Model == null || Model.Count == 0)
    {
        <p>No jobs found matching your criteria.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Priority</th>
                    <th>Title</th>
                    <th>Company</th>
                    <th>Location</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    var jobId = item.Job.ContainsKey("job_id") ? item.Job["job_id"] : null;
                    var title = item.Job.ContainsKey("title") ? item.Job["title"] : "N/A";
                    var company = item.Job.ContainsKey("company") ? item.Job["company"] : "N/A";
                    var location = item.Job.ContainsKey("location") ? item.Job["location"] : "N/A";
                    var description = item.Job.ContainsKey("description") ? item.Job["description"] : "N/A";
                    var url = item.Job.ContainsKey("webpage_url") ? item.Job["webpage_url"] : "#";
                <tr>
                    <td>@item.Priority</td>
                    <td>
                        <a href="@url" target="_blank" class="text-primary" onclick="toggleApplyFormAndOpen(event, @i, '@url')">@title</a>
                    </td>
                    <td>@company</td>
                    <td>@location</td>
                    <td>@description</td>
                </tr>
                <tr id="applyRow-@i" style="display:none;">
                    <td colspan="5">
                        <form asp-controller="JobApplication" asp-action="Apply" method="post">
                            <input type="hidden" name="jobId" value="@jobId" />
                            <textarea name="notes" placeholder="Add note (optional)" class="form-control"></textarea>
                            <button type="submit" id="applyBtn-@i" class="btn btn-primary mt-2">✅ Mark as Applied</button>
                        </form>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    }
</div>

@foreach (var job in Model)
{
    <div>
        <span>@job.Job["title"]</span>
        <form asp-action="AnalyzeJob" asp-controller="Jobs" method="post">
            <input type="hidden" name="jobAdUrl" value="@job.Job["pdf_url"]" />
            <button type="submit">Analyze with AI</button>
        </form>
    </div>
}

@section Scripts {
    <script>
        function toggleApplyFormAndOpen(event, index, url) {
            // Open the URL in a new tab
            window.open(url, '_blank');
            // Show the apply form for this job
            document.querySelectorAll('[id^="applyRow-"]').forEach(row => row.style.display = "none");
            document.getElementById("applyRow-" + index).style.display = "";
            // Prevent default link navigation (so it doesn't also open in the current tab)
            event.preventDefault();
        }

        function markApplied(form, index) {
            var btn = document.getElementById("applyBtn-" + index);
            btn.classList.remove("btn-primary");
            btn.classList.add("btn-success");
            btn.innerText = "✅ Applied";
            btn.disabled = true;
            return false; // Prevent actual form submission for demo
        }
    </script>
}