@{
    ViewData["Title"] = "Check Your Email";
}

<h2>Check Your Email</h2>
<p>
    Thank you for registering! A verification email has been sent to your email address. Please check your inbox and spam folder, and click the verification link to activate your account.
</p>
<p>If you haven't received the email, you can <form method="post" action="@Url.Action("ResendVerificationEmail", "Register")">
    <input type="hidden" name="email" value="@ViewBag.Email" />
    <button type="submit" class="btn btn-link">Click here</button>
</form></p>
<!-- Add a Home button -->
<a href="/" class="btn btn-primary">Go to Home</a>
