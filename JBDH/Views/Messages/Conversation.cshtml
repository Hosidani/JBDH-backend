@model List<JBDH.Models.Messaging.Message>
@{
    ViewData["Title"] = "Conversation";
    var otherUserId = (int)ViewBag.OtherUserId;
}

@functions {
    // Simple URL to clickable link
    public static string Linkify(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";
        var urlPattern = @"(http[s]?://[^\s]+)";
        return System.Text.RegularExpressions.Regex.Replace(
            text,
            urlPattern,
            "<a href=\"$1\" target=\"_blank\" rel=\"noopener\">$1</a>"
        );
    }
}

<h2>Conversation with User @otherUserId</h2>

@if (!Model.Any())
{
    <p>No messages yet.</p>
}
else
{
    <ul class="list-group">
    @foreach (var msg in Model)
    {
        <li class="list-group-item">
            <strong>@(msg.SenderId == otherUserId ? "Them" : "You"):</strong>
            @Html.Raw(Linkify(msg.Content))
            <span class="text-muted float-end">@msg.SentAt.ToString("g")</span>
        </li>
    }
    </ul>
}

<a asp-action="Send" asp-route-userId="@otherUserId" class="btn btn-primary mt-3">Send Message</a>