@using Markdig
@model JBDH.Models.ViewModels.ProfileViewModel


@{
    ViewData["Title"] = "My Profile";
}

<h2 class="mt-4">My Profile</h2>

<div class="card p-4 mt-3 shadow-sm">
    <dl class="row">
        <dt class="col-sm-3">Username:</dt>
        <dd class="col-sm-9">@Model.User.Username</dd>

        <dt class="col-sm-3">Email:</dt>
        <dd class="col-sm-9">@Model.User.Email</dd>

        <dt class="col-sm-3">Organisation:</dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrEmpty(Model.Organisation?.Name))
            {
                <span>@Model.Organisation.Name</span>
                @Html.ActionLink("View Organization", "Details", "Organisation", new { id = Model.User.Id }, null)
            }
            else
            {
                <span>N/A</span>
            }
        </dd>

        <dt class="col-sm-3">Open for Hiring:</dt>
        <dd class="col-sm-9">
            @if (Model.User.OpenForHiring == true)
            {
                <span class="badge bg-success">Open</span>
            }
            else
            {
                <span class="badge bg-secondary">Closed</span>
            }
        </dd>

        <dt class="col-sm-3">Developer Mode:</dt>
        <dd class="col-sm-9">
            @if (Model.User.DeveloperMode == true)
            {
                <span class="badge bg-info">Developer</span>
            }
            else
            {
                <span class="badge bg-light text-dark">User</span>
            }
        </dd>

        <dt class="col-sm-3">CV:</dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrEmpty(Model.User.CVPath))
            {
                <a href="@Url.Content("~/uploads/" + System.IO.Path.GetFileName(Model.User.CVPath))" target="_blank" class="btn btn-primary btn-sm">
                    View CV
                </a>
            }
            else
            {
                <span>No CV uploaded</span>
            }
        </dd>
        </dd>
    </dl>
</div>

@if (Model.CVAnalysisResult != null)
{
    <div class="card p-4 mt-3 shadow-sm">
        <h3>Analysis made based on CV</h3>
        <div class="row">
            <div class="col-md-4 mb-3">
                <h5>Best Job Titles</h5>
                <ul>
                    @foreach (var title in Model.CVAnalysisResult.BestJobTitlesForUser ?? new List<string>())
                    {
                        <li>@title</li>
                    }
                </ul>
            </div>
            <div class="col-md-4 mb-3">
                <h5>Hard Skills</h5>
                <ul>
                    @foreach (var skill in Model.CVAnalysisResult.HardSkills ?? new List<string>())
                    {
                        <li>@skill</li>
                    }
                </ul>
            </div>
            <div class="col-md-4 mb-3">
                <h5>Soft Skills</h5>
                <ul>
                    @foreach (var skill in Model.CVAnalysisResult.SoftSkills ?? new List<string>())
                    {
                        <li>@skill</li>
                    }
                </ul>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-md-12 mb-3">
                <h5>Experiences</h5>
                <ul>
                    @foreach (var exp in Model.CVAnalysisResult.Experiences ?? new List<JBDH.Models.User.ExperienceItem>())
                    {
                        <li>
                            <strong>@exp.Title</strong>
                            <span class="text-muted">(@exp.Duration)</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <h5>Education & Certifications</h5>
                <ul>
                    @foreach (var edu in Model.CVAnalysisResult.EducationAndCertifications ?? new List<string>())
                    {
                        <li>@edu</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}
else
{
    <span>No AI analysis available.</span>
}

<form asp-action="UpdateAboutMe" method="post" class="mt-4">
    <div class="mb-3">
        <label for="AboutMe" class="form-label">About Me</label>
        <textarea id="AboutMe" name="aboutMe" class="form-control" rows="5">@Model.User.AboutMe</textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save About Me</button>
</form>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<h4>My Friends</h4>
@if (Model.Friends != null && Model.Friends.Any())
{
    <ul>
        @foreach (var friend in Model.Friends)
        {
            <li>@friend.Username</li>
        }
    </ul>
}
else
{
    <p>You have no friends yet.</p>
}

<h4>Pending Friend Requests</h4>
@if (Model.PendingFriendRequests != null && Model.PendingFriendRequests.Any())
{
    <ul>
        @foreach (var request in Model.PendingFriendRequests)
        {
            <li>
                @request.Requester.Username
                <form asp-action="AcceptFriendRequest" method="post" style="display:inline;">
                    <input type="hidden" name="friendshipId" value="@request.Id" />
                    <button type="submit" class="btn btn-success btn-sm">Accept</button>
                </form>
                <form asp-action="DeclineFriendRequest" method="post" style="display:inline;">
                    <input type="hidden" name="friendshipId" value="@request.Id" />
                    <button type="submit" class="btn btn-danger btn-sm">Decline</button>
                </form>
            </li>
        }
    </ul>
}
else
{
    <p>No pending friend requests.</p>
}

<h4>My Job Applications</h4>
@if (Model.JobApplications != null && Model.JobApplications.Any())
{
    <ul>
        @foreach (var app in Model.JobApplications)
        {
            <li>
                <strong>
                    @if (!string.IsNullOrEmpty(app.JobUrl))
                    {
                        <a href="@app.JobUrl" target="_blank">@app.JobTitle</a>
                    }
                    else
                    {
                        @app.JobTitle
                    }
                </strong>
                <br />
                <span>@app.JobDescription</span>
                <br />
                Applied At: @app.AppliedAt.ToString("yyyy-MM-dd")
                <form asp-action="UpdateJobApplicationNotes" method="post" class="mt-2">
                    <input type="hidden" name="applicationId" value="@app.ApplicationId" />
                    <label for="notes-@app.ApplicationId">Notes:</label>
                    <textarea id="notes-@app.ApplicationId" name="notes" class="form-control"
                        rows="2">@app.Notes</textarea>
                    <button type="submit" class="btn btn-primary btn-sm mt-1">Save Notes</button>
                </form>
            </li>
        }
    </ul>
}
else
{
    <p>You have not applied to any jobs yet.</p>
}

@if (Model.CVAnalysisResult != null && 
     Model.CVAnalysisResult.Experiences != null && 
     Model.CVAnalysisResult.Experiences.Any(e => !string.IsNullOrWhiteSpace(e.Title)))
{
    <ul>
        @foreach (var exp in Model.CVAnalysisResult.Experiences)
        {
            if (!string.IsNullOrWhiteSpace(exp.Title))
            {
                <li>
                    <strong>@exp.Title</strong>
                    @if (!string.IsNullOrWhiteSpace(exp.Duration))
                    {
                        <span class="text-muted">(@exp.Duration)</span>
                    }
                </li>
            }
        }
    </ul>
}
else
{
    <span>No experiences found.</span>
}
