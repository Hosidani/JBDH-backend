@model JBDH.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

<h2 class="mt-4">Profile Information</h2>

<div class="card p-4 mt-3 shadow-sm">
    <dl class="row">
        <dt class="col-sm-3">Username:</dt>
        <dd class="col-sm-9">@Model.User.Username</dd>

        <dt class="col-sm-3">Email:</dt>
        <dd class="col-sm-9">@Model.User.Email</dd>

        <dt class="col-sm-3">Organisation:</dt>
        <dd class="col-sm-9">@(!string.IsNullOrEmpty(Model.User.Organization?.Name) ? Model.User.Organization.Name : "N/A")</dd>

        <dt class="col-sm-3">Open for Hiring:</dt>
        <dd class="col-sm-9">
            @if (Model.User.OpenForHiring == true)
            {
                <span class="badge bg-success">Open</span>
            }
            else
            {
                <span class="badge bg-secondary">Closed</span>
            }
        </dd>

        <dt class="col-sm-3">Developer Mode:</dt>
        <dd class="col-sm-9">
            @if (Model.User.DeveloperMode == true)
            {
                <span class="badge bg-info">Developer</span>
            }
            else
            {
                <span class="badge bg-light text-dark">User</span>
            }
        </dd>

        <dt class="col-sm-3">CV:</dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrEmpty(Model.User.CVPath))
            {
                <a href="@Url.Content("~/uploads/" + System.IO.Path.GetFileName(Model.User.CVPath))" target="_blank" class="btn btn-primary btn-sm">
                    View CV
                </a>
            }
            else
            {
                <span>No CV uploaded</span>
            }
        </dd>
    </dl>
    @if (Model.User != null)
    {
        @if (!Model.IsFriend) 
        {
            <form method="post" asp-action="SendFriendRequest" asp-route-addresseeId="@Model.User.Id">
                <button type="submit" class="btn btn-success">Send Friend Request</button>
            </form>
        }
        else
        {
            <button class="btn btn-secondary" disabled>Already Friends</button>
        }
    }
    else
    {
        <p>User not found.</p>
    }
</div>