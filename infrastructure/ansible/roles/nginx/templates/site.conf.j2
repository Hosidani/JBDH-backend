# Jinja2 template — rendered differently for each environment
# Variables: domain, frontend_port, backend_port

server {
    listen 80;
    server_name {{ domain }};

    # Certbot will inject the SSL block here automatically.
    # After certbot runs, this file will be rewritten to redirect HTTP → HTTPS.

    # Frontend (React/Vite SPA in Docker)
    location / {
        proxy_pass         http://127.0.0.1:{{ frontend_port }};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Django REST API
    location /api/ {
        proxy_pass         http://127.0.0.1:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Django Admin
    location /django-admin/ {
        proxy_pass         http://127.0.0.1:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Static files served directly (optional optimisation)
    location /static/ {
        alias /opt/{{ project_name }}/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
