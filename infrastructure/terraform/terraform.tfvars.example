# ─────────────────────────────────────────────
# terraform.tfvars  (NEVER commit this file)
# Add it to .gitignore
# ─────────────────────────────────────────────

# Get from: https://console.hetzner.cloud → Project → Security → API Tokens
hcloud_token = "YOUR_HETZNER_API_TOKEN"

# Your local SSH public key (cat ~/.ssh/id_ed25519.pub)
# or use the key in JBDH_backend/standard.pub
ssh_public_key = "ssh-ed25519 AAAA... your-email@example.com"

# Dev server — keep false until the dev branch workflow is ready
create_dev = false
