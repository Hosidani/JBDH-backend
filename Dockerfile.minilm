FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-minilm.txt /app/
RUN pip install --upgrade pip && pip install --no-cache-dir -r requirements-minilm.txt

COPY minilm_service/ /app/minilm_service/

EXPOSE 8000

CMD ["uvicorn", "minilm_service.main:app", "--host", "0.0.0.0", "--port", "8000"]

