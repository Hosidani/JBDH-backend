DEBUG=False
SECRET_KEY=replace-with-strong-secret-key
DJANGO_SETTINGS_MODULE=config.settings.production

# Database
DATABASE_NAME=jbdh_db
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-strong-db-password
DATABASE_HOST=postgres
DATABASE_PORT=5432

# AI Services
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-001:embedContent

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=replace-with-email-username
SMTP_PASSWORD=replace-with-email-password
DEFAULT_FROM_EMAIL=replace-with-from-email
