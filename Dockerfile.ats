FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-ats.txt /app/

RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements-ats.txt

# Download English and Swedish spaCy models (~12 MB each, no torch required)
RUN python -m spacy download en_core_web_sm \
    && python -m spacy download sv_core_news_sm

COPY ats_service/ /app/ats_service/
COPY tests/ /app/tests/

EXPOSE 8001

CMD ["uvicorn", "ats_service.main:app", "--host", "0.0.0.0", "--port", "8001"]
